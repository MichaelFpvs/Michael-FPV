---
import { navLinks, url } from '../data/site';

// Astro.url.pathname includes the base path (/Michael-FPV/...), so compare
// against the fully-prefixed href rather than the raw one.
const path = Astro.url.pathname;
const isActive = (raw: string) => {
  const full = url(raw);
  return raw === '/' ? path === full : path.startsWith(full);
};
---

<nav id="nav">
  <div class="nav-inner">
    <a href={url('/')} class="logo" aria-label="Michael FPV — home">
      <span class="logo-name">MICHAEL<span>FPV</span></span>
    </a>

    <div class="nav-links">
      {
        navLinks.map((l) => (
          <a
            href={url(l.href)}
            class:list={['nav-a', { on: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <a href={url('/book/')} class="nav-cta" aria-label="Book a shoot">
      <span class="cta-long">Book a Shoot</span>
      <span class="cta-short" aria-hidden="true">Book</span>
    </a>
  </div>
</nav>
