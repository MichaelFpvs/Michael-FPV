---
import { site, url } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <a href={url('/')} class="logo" aria-label="Michael FPV — home">
          <span class="logo-name">MICHAEL<span>FPV</span></span>
        </a>
        <p class="foot-desc" style="margin-top:0.3rem;font-family:var(--M);font-size:0.72rem;color:var(--grey2)">
          {site.owner}
        </p>
        <p class="foot-desc">
          Charlotte's FPV drone media team. Real estate, weddings, events, and commercial production.
        </p>
      </div>

      <div>
        <div class="foot-h">Services</div>
        <div class="foot-links">
          <a href={url('/services/')}>Real Estate</a>
          <a href={url('/services/')}>Weddings</a>
          <a href={url('/services/')}>Commercial</a>
          <a href={url('/services/')}>Production FPV</a>
        </div>
      </div>

      <div>
        <div class="foot-h">Studio</div>
        <div class="foot-links">
          <a href={url('/bts/')}>BTS</a>
          <a href={url('/portfolio/')}>Portfolio</a>
          <a href={url('/book/')}>Book a Shoot</a>
        </div>
      </div>

      <div>
        <div class="foot-h">Contact</div>
        <div class="foot-links">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>
        </div>
        <p class="body-sm" style="margin-top:1.2rem">
          FAA <span style="color:#e53935">Part 107</span> Certified &middot; Insured
        </p>
      </div>
    </div>

    <div class="foot-bottom">
      <span class="foot-copy">&copy; {year} {site.name}</span>
      <div class="foot-legal">
        <a href={url('/terms/')}>Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
