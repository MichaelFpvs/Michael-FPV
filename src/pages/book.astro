---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const serviceOptions = [
  'Real Estate — Drone Tour',
  'Real Estate — Standard Kit',
  'Real Estate — Elite',
  'Weddings',
  'Commercial / Venue',
  'Production FPV',
  'Custom / Not Sure',
];

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Book a Shoot — Michael FPV',
    description: 'Request a custom quote for drone videography in Charlotte NC.',
  },
];
---

<Base
  title="Book a Shoot — Get a Custom Quote | Michael FPV"
  description="Request a custom drone videography quote for your property, wedding, or brand shoot. Charlotte NC based. Most quotes returned within the hour."
  schema={schema}
>
  <div class="page-banner">
    <div class="wrap">
      <div class="eyebrow">Get In Touch</div>
      <h1>Book a <em>Shoot.</em></h1>
      <p>
        Send us your project details and we'll get back with a custom price. No commitment, no vague
        estimates — just a real number for your real shoot.
      </p>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="grid-2" style="gap:4rem;align-items:start">
        <div class="rv-l">
          <form id="bookForm" novalidate>
            <div style="display:flex;flex-direction:column;gap:1.2rem">
              <!-- Spam trap: invisible to people, irresistible to bots. -->
              <input
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0"
              />
              <div>
                <label class="flabel" for="f-name">Name</label>
                <input type="text" class="finp" id="f-name" name="name" placeholder="Your full name" required autocomplete="name" />
              </div>
              <div>
                <label class="flabel" for="f-email">Email</label>
                <input type="email" class="finp" id="f-email" name="email" placeholder="you@example.com" required autocomplete="email" />
              </div>
              <div>
                <label class="flabel" for="f-phone">Phone</label>
                <input type="tel" class="finp" id="f-phone" name="phone" placeholder="(704) 555-0100" autocomplete="tel" />
              </div>
              <div>
                <label class="flabel" for="f-address">Address / Venue</label>
                <input type="text" class="finp" id="f-address" name="address" placeholder="Address or venue name" />
              </div>
              <div>
                <label class="flabel" for="f-service">Service</label>
                <select class="finp" id="f-service" name="service">
                  {serviceOptions.map((o) => <option>{o}</option>)}
                </select>
              </div>
              <div>
                <label class="flabel" for="f-details">Details</label>
                <textarea class="finp" id="f-details" name="details" rows="4" placeholder="Tell us about the shoot..."></textarea>
              </div>
              <button type="submit" class="btn btn-gold" style="justify-content:center;margin-top:0.5rem">
                Send Request
              </button>
              <p id="formMsg" role="status" aria-live="polite" style="display:none;font-family:var(--M);font-size:0.8rem"></p>
            </div>
          </form>
        </div>

        <div class="rv-r">
          <div class="card" style="margin-bottom:1.2rem">
            <div class="eyebrow" style="margin-bottom:1rem">Direct Contact</div>
            <a href={site.phoneHref} style="display:block;font-family:var(--M);font-size:1.1rem;color:var(--white);margin-bottom:0.6rem">
              {site.phone}
            </a>
            <a href={`mailto:${site.email}`} style="display:block;font-family:var(--M);font-size:0.95rem;color:var(--grey2);margin-bottom:0.6rem">
              {site.email}
            </a>
            <a href={site.instagram} target="_blank" rel="noopener" style="font-family:var(--M);font-size:0.95rem;color:var(--gold);display:inline-flex;align-items:center;gap:0.4rem">
              {site.instagramHandle}
            </a>
          </div>
          <div class="card">
            <div class="eyebrow" style="margin-bottom:1rem">What Happens Next</div>
            <p class="body-sm">
              We review your details and reply with a custom quote, usually within the hour during
              business hours. Once confirmed, your date is locked on the calendar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ endpoint: site.formspree, email: site.email }}>
  const form = document.getElementById('bookForm');
  const msg = document.getElementById('formMsg');
  const btn = form.querySelector('button[type=submit]');

  function show(text, ok) {
    msg.textContent = text;
    msg.style.color = ok ? 'var(--gold2)' : '#e53935';
    msg.style.display = 'block';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));

    if (!data.name?.trim() || !data.email?.trim()) {
      show('Please enter your name and email.', false);
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email)) {
      show('That email address does not look right.', false);
      return;
    }

    // _replyto makes Reply in your inbox go straight to the client
    // instead of to Formspree. _subject makes the enquiry easy to spot.
    data._replyto = data.email;
    data._subject = `New booking enquiry — ${data.service || 'Michael FPV'} — ${data.name}`;

    btn.textContent = 'Sending...';
    btn.disabled = true;

    try {
      const r = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await r.json().catch(() => ({}));
      if (r.ok || json.ok || json.next) {
        show("✓ Request sent — we'll be in touch shortly.", true);
        btn.textContent = 'Sent!';
        form.reset();
      } else {
        throw new Error('bad response');
      }
    } catch {
      show(`Something went wrong. Please email us directly at ${email}`, false);
      btn.textContent = 'Send Request';
      btn.disabled = false;
    }
  });
</script>
