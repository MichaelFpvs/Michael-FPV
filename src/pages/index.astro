---
import Base from '../layouts/Base.astro';
import { site, streamUrl, heroStreams, portraitCovers, aboutStream, categories, faqs, aboutPoints, services, url, filmCount, PLAYER_ALLOW } from '../data/site';

// Just two on the home page — a taste, not the whole portfolio.
const featured = categories.filter((c) => c.slug === 'weddings' || c.slug === 'moto-auto');
---

<Base
  title="Michael FPV — Charlotte Drone Cinematography"
  description={site.description}
  includeFaq={true}
>
  <!-- HERO -->
  <section id="hero">
    <div class="hero-vid-wrap">
      <iframe
        src={streamUrl(heroStreams.home)}
        title="Michael FPV showreel"
        allow={PLAYER_ALLOW}
        aria-hidden="true"></iframe>
    </div>
    <div class="hero-over"></div>
    <div class="hero-content" id="hero-content">
      <h1 class="h-xl">One flight.<br /><em>No cuts.</em></h1>
      <p class="hero-sub">
        FPV drone cinematography for real estate, weddings, and brands. The whole property in one
        continuous take — through the door, down the hall, out over the roof. Charlotte based,
        flying nationwide.
      </p>
      <div class="hero-btns">
        <a class="btn btn-gold" href={url('/book/')}>Book a Shoot</a>
        <a class="btn btn-line" href={url('/portfolio/')}>View Portfolio</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="hstat-n"><span class="p107">Part 107</span></div>
          <div class="hstat-l">FAA Licensed</div>
        </div>
        <div>
          <div class="hstat-n">USA Wide</div>
          <div class="hstat-l">All 50 States</div>
        </div>
        <div>
          <div class="hstat-n">Charlotte</div>
          <div class="hstat-l">Located In</div>
        </div>
      </div>
    </div>
  </section>

  <div id="home-content" style="position:relative;z-index:2;background:var(--paper)">
    <!-- TICKER -->
    <div class="strip">
      <div class="strip-inner">
        {
          [0, 1].map(() => (
            <>
              <span class="strip-item">Charlotte FPV <b>&#9671;</b></span>
              <span class="strip-item">24-Hour Delivery <b>&#9671;</b></span>
              <span class="strip-item">
                FAA <span class="p107">Part 107</span> Certified <b>&#9671;</b>
              </span>
              <span class="strip-item">Real Estate &middot; Weddings &middot; Events <b>&#9671;</b></span>
            </>
          ))
        }
      </div>
    </div>

    <!-- ABOUT -->
    <section class="sec">
      <div class="wrap">
        <div class="grid-2 rv" style="align-items:center;gap:3rem">
          <div>
            <div class="eyebrow">What We Do</div>
            <h2 class="h-lg" style="margin-bottom:1.8rem">The <em>work.</em></h2>
            <div class="about-vid">
              <iframe
                src={streamUrl(aboutStream)}
                title="Michael FPV behind the scenes"
                allow={PLAYER_ALLOW}
                aria-hidden="true"></iframe>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;justify-content:center">
            <p class="body-txt">
              At Michael FPV, we specialize in professional FPV drone videography that transforms
              ordinary spaces into unforgettable experiences.
            </p>
            <p class="body-txt" style="margin-top:1rem">
              Based in {site.city}, {site.regionFull}, we proudly serve clients throughout the
              Charlotte area and are available for projects across the United States.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT WE SHOOT -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="sec-lead rv">
          <div class="eyebrow">What We Offer</div>
          <h2 class="h-lg">What we <em>offer.</em></h2>
          <p>
            Based in Charlotte with no travel fee locally — and available for shoots across all 50
            states, with travel quoted upfront.
          </p>
        </div>

        <div class="svc-cards rv-stagger">
          {
            services.map((s) => (
              <a href={url('/services/')} class="svc-card">
                <h3 class="svc-card-title">{s.title.replace(' — ', ' ')}</h3>
                <p class="svc-card-text">{s.preview}</p>
                <span class="svc-card-more">
                  Details <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="svc-foot rv">
          <p class="body-sm">
            Every booking includes 4K delivery, colour grading, and footage you own outright.
          </p>
          <a class="btn btn-line" href={url('/services/')}>All Services &amp; Pricing</a>
        </div>
      </div>
    </section>

    <!-- FEATURED WORK -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="reel-head rv">
          <div>
            <div class="eyebrow">Selected Work</div>
            <h2 class="h-lg">From the <em>portfolio.</em></h2>
          </div>
          <a class="btn btn-line" href={url('/portfolio/')}>View All Work</a>
        </div>
      </div>

      <div class="wrap">
        <div class="reel">
        {
          featured.map((cat, i) => (
            <a
              href={url(`/portfolio/${cat.slug}/`)}
              class="reel-item rv"
              aria-label={`View ${cat.title} work`}
            >
              <div class={`reel-media${portraitCovers.includes(cat.cover!) ? ' is-portrait' : ''}`}>
                <iframe
                  src={streamUrl(cat.cover!)}
                  title={`${cat.title} preview`}
                  allow={PLAYER_ALLOW}
                  aria-hidden="true"
                />
                <div class="reel-scrim" />
              </div>
              <div class="reel-label">
                <div class="reel-label-inner">
                  <span class="reel-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="reel-title">{cat.title}</h3>
                  <span class="reel-count">
                    {filmCount(cat)} {filmCount(cat) === 1 ? 'film' : 'films'}
                    <span class="reel-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </div>
            </a>
          ))
          }
        </div>
      </div>
    </section>

    <!-- WHAT YOU CAN BOOK -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="sec-lead rv">
          <div class="eyebrow">What You Can Book</div>
          <h2 class="h-lg">Four ways to <em>work together.</em></h2>
        </div>

        <div class="book-grid rv-stagger">
          <a class="book-card" href={url('/services/')}>
            <span class="book-num">01</span>
            <h3>Real estate</h3>
            <p>One continuous flythrough of the property. MLS-ready, delivered in 24 hours.</p>
            <span class="book-go" aria-hidden="true">→</span>
          </a>
          <a class="book-card" href={url('/services/')}>
            <span class="book-num">02</span>
            <h3>Weddings</h3>
            <p>Ceremony and reception aerials, flown quiet, alongside your main video team.</p>
            <span class="book-go" aria-hidden="true">→</span>
          </a>
          <a class="book-card" href={url('/services/')}>
            <span class="book-num">03</span>
            <h3>Commercial &amp; venues</h3>
            <p>Interior flythroughs and exterior aerials for hotels, restaurants, and event spaces.</p>
            <span class="book-go" aria-hidden="true">→</span>
          </a>
          <a class="book-card" href={url('/services/')}>
            <span class="book-num">04</span>
            <h3>Production FPV</h3>
            <p>Cinema-grade tracking for ads, music videos, and branded shoots. Custom scope.</p>
            <span class="book-go" aria-hidden="true">→</span>
          </a>
        </div>

        <p class="book-note rv">
          Every booking includes 4K, colour grading, and footage you own outright.
          <a href={url('/services/')}>See the full breakdown →</a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="sec-lead rv">
          <div class="eyebrow">Questions</div>
          <h2 class="h-lg">What people <em>ask.</em></h2>
        </div>
        <div class="faq-grid rv-stagger">
          {
            faqs.map((f) => (
              <div class="faq-box">
                <h3 set:html={f.q.replace('Part 107', '<span class="p107">Part 107</span>')} />
                <p set:html={f.a.replace('Part 107', '<span class="p107">Part 107</span>')} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- WHO YOU'RE HIRING -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="pilot rv">
          <div class="pilot-photo">
            <img
              src={url('/michael.jpg')}
              alt="Michael flying an FPV drone, wearing video goggles and holding the controller"
              width="797"
              height="1196"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="pilot-reach">
            <span class="p107">Part 107</span>
            <span>Charlotte, NC</span>
            <span>Available in all 50 states</span>
          </p>
          <div class="pilot-text">
            <div class="eyebrow">The Pilot</div>
            <h2 class="h-lg">About <em>Michael.</em></h2>
            <p class="body-txt" style="margin-top:1.6rem">
              I'm Michael, and I'm in my third year flying FPV. Everything on this site was shot by
              me — I fly it, I cut it, and I'm the person you'll be dealing with from the first
              message to the final file.
            </p>
            <p class="body-txt" style="margin-top:1rem">
              FPV is flown by hand through goggles, with no GPS holding the aircraft steady. Getting
              to the point where you can take a drone through a doorway at speed without clipping a
              frame takes years of practice, and it's the reason this footage looks different from a
              drone hovering outside the window.
            </p>
          </div>
        </div>
        <div class="about-grid rv-stagger">
          {
            aboutPoints.map((p) => (
              <div class="about-box">
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <div
          class="rv"
          style="background:var(--paper-2);border:1px solid var(--rule);border-radius:20px;padding:4rem 3rem;text-align:center"
        >
          <h2 class="h-lg" style="margin-bottom:1rem">Have a listing<br />worth <em>filming?</em></h2>
          <p class="body-txt" style="max-width:480px;margin:0 auto 2rem">
            Send the address or scope, we'll get back within the hour during business hours.
          </p>
          <a class="btn btn-gold" href={url('/book/')}>Book a Shoot</a>
        </div>
      </div>
    </section>
  </div>
</Base>
