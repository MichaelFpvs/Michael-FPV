---
import Base from '../layouts/Base.astro';
import { streamUrl, url, PLAYER_ALLOW } from '../data/site';
import { btsIntro, btsGear, btsCredentials } from '../data/bts';

const btsVideos = ['bb0125f037c6c25e16526dad7c869fb4', '580409878c4579b2c7d65eed3b8fc889'];
---

<Base
  title="Behind the Scenes — How We Shoot | Michael FPV"
  description="How a Michael FPV drone shoot works: the rigs we fly, our scouting and flight-planning process, and how footage goes from capture to delivery."
>
  <div class="page-banner">
    <div class="wrap">
      <div class="eyebrow">Behind the Scene</div>
      <h1><em>BTS.</em></h1>
      <p>
        Go behind the scenes with Michael FPV — the rigs, the process, and the footage before it gets
        edited.
      </p>
    </div>
  </div>

  <!-- HOW WE WORK -->
  <section class="sec">
    <div class="wrap">
      <div class="grid-2 rv" style="align-items:center;gap:3rem">
        <div style="display:flex;flex-direction:column;align-items:center;text-align:center">
          <div class="eyebrow" style="justify-content:center">How We Work</div>
          <h2 class="h-md" style="margin-bottom:1.4rem">Behind <em>every shot.</em></h2>
          <div style="display:flex;gap:0.8rem;width:100%;max-width:320px">
            {
              btsVideos.map((id, i) => (
                <div class="bts-vid">
                  <iframe
                    src={streamUrl(id)}
                    title={`Behind the scenes clip ${i + 1}`}
                    allow={PLAYER_ALLOW}
                    aria-hidden="true"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div style="display:flex;flex-direction:column;justify-content:center">
          {btsIntro.map((p) => <p class="body-txt" style="margin-bottom:1rem">{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- THE GEAR -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="eyebrow rv" style="margin-bottom:1rem">The Gear</div>
      <h2 class="h-lg rv" style="margin-bottom:2.5rem">What we <em>fly.</em></h2>

      <div class="gear-lead rv">
        <figure class="gear-shot">
          <img
            src={url('/gear.jpg')}
            alt="A ducted FPV cinewhoop held up inside an event marquee before a shoot, with rows of seating and the stage behind it"
            width="768"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="gear-lead-text">
          <p class="body-txt">
            This is our ducted cinewhoop. The cage around the propellers is the whole point — it
            lets the drone fly close to people, walls, and furniture without any risk, which a bare
            propeller could never do.
          </p>
          <p class="body-txt" style="margin-top:1rem">
            It's light, it's quiet, and it fits through doorways and between rows of chairs. That's
            what makes the indoor flythroughs possible: the camera can go where a full-size drone
            simply can't.
          </p>
        </div>
      </div>

      <div class="grid-2 rv-stagger" style="gap:2.5rem">
        {
          btsGear.map((g) => (
            <div class="card">
              <div class="eyebrow" style="margin-bottom:0.8rem">{g.eyebrow}</div>
              <h3 class="h-md" style="font-size:1.2rem;margin-bottom:0.9rem">{g.title}</h3>
              {g.paras.map((p, i) => (
                <p class="body-txt" style={i ? 'margin-top:1rem' : ''}>{p}</p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="eyebrow rv" style="margin-bottom:1rem">Credentials</div>
      <h2 class="h-lg rv" style="margin-bottom:2rem">Licensed. <em>Insured.</em></h2>
      <div class="rv">
        {
          btsCredentials.map((r) => (
            <div class="num-row" style="cursor:default">
              <div class="num-tag">&mdash;</div>
              <div class="num-body">
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
              <div />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div
        class="rv"
        style="background:var(--paper-2);border:1px solid var(--rule);border-radius:20px;padding:4rem 3rem;text-align:center"
      >
        <h2 class="h-lg" style="margin-bottom:1rem">Let's get your<br /><em>shoot scheduled.</em></h2>
        <a class="btn btn-gold" href={url('/book/')}>Book a Shoot</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bts-vid {
    position: relative;
    aspect-ratio: 9 / 16;
    flex: 1;
    border-radius: 14px;
    overflow: hidden;
    background: var(--paper-3);
  }
  .bts-vid iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>
