---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { termsSections } from '../data/terms';
---

<Base
  title="Terms of Service | Michael FPV"
  description="Booking terms, deposit and refund policy, delivery timelines, usage rights, and FAA compliance for Michael FPV drone videography services."
>
  <div class="page-banner">
    <div class="wrap">
      <div class="eyebrow">Last Updated June 2026</div>
      <h1>Terms of <em>Service.</em></h1>
    </div>
  </div>

  <section class="sec">
    <div class="wrap" style="max-width:820px">
      <div style="display:flex;flex-direction:column;gap:2.6rem">
        {
          termsSections.map((s) => (
            <div>
              <div class="eyebrow" style="margin-bottom:0.8rem">{s.eyebrow}</div>
              <h2 class="h-md" style="font-size:1.1rem;margin-bottom:0.7rem">{s.heading}</h2>
              {s.paras.map((p) => (
                <p class="body-txt" style="margin-bottom:0.9rem">{p}</p>
              ))}
            </div>
          ))
        }

        <div class="card">
          <p class="body-sm" style="margin-bottom:0.5rem">
            Questions about these terms? Contact us directly before booking.
          </p>
          <a href={site.phoneHref} style="font-family:var(--M);font-size:0.85rem;color:var(--accent)">
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
