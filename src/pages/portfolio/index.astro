---
import Base from '../../layouts/Base.astro';
import { categories, streamUrl, url, filmCount, PLAYER_ALLOW } from '../../data/site';

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Portfolio — Michael FPV',
    hasPart: categories.map((c) => ({
      '@type': 'CreativeWork',
      name: c.title,
      url: new URL(`/portfolio/${c.slug}/`, Astro.site).href,
    })),
  },
];
---

<Base
  title="Portfolio — Drone Cinematography Work | Michael FPV"
  description="Real client drone work: wedding aerials, real estate flythroughs, automotive tracking, and commercial production. Shot in Charlotte NC, available nationwide."
  schema={schema}
>
  <div class="page-banner">
    <div class="wrap">
      <div class="eyebrow">Our Work</div>
      <h1>The <em>Portfolio.</em></h1>
      <p>
        A collection of real client work — weddings, real estate flythroughs, moto and automotive
        tracking, and commercial production. No stock footage, no composites: every clip is from an
        actual shoot.
      </p>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="rv-stagger" style="display:flex;flex-direction:column;gap:1.4rem">
        {
          categories.map((cat) => (
            <a
              href={url(`/portfolio/${cat.slug}/`)}
              class="pf-cat"
              aria-label={`View ${cat.title} portfolio`}
            >
              {cat.cover && (
                <iframe
                  src={streamUrl(cat.cover)}
                  title={`${cat.title} preview`}
                  allow={PLAYER_ALLOW}
                  aria-hidden="true"
                />
              )}
              <div class="pf-cat-scrim" />
              <div class="pf-cat-over" />
              <div class="pf-cat-info">
                <div>
                  <div class="pf-count">
                    {filmCount(cat)} {filmCount(cat) === 1 ? 'film' : 'films'}
                  </div>
                  <div style="font-family:var(--D);font-size:clamp(1.5rem,2.5vw,2.2rem);font-weight:700;color:#fff">
                    {cat.title}
                  </div>
                </div>
                <div style="width:44px;height:44px;border-radius:50%;border:1px solid rgba(245,243,238,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      stroke="#f5f3ee"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div
        class="rv"
        style="background:var(--b1);border:1px solid var(--line);border-radius:20px;padding:4rem 3rem;text-align:center"
      >
        <h2 class="h-lg" style="margin-bottom:1rem">Like what you <em>see?</em></h2>
        <p class="body-txt" style="max-width:480px;margin:0 auto 2rem">
          Let's get your shoot on the calendar.
        </p>
        <a class="btn btn-gold" href={url('/book/')}>Book a Shoot</a>
      </div>
    </div>
  </section>
</Base>
