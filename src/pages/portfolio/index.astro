---
import Base from '../../layouts/Base.astro';
import { categories, streamUrl, url, filmCount, PLAYER_ALLOW } from '../../data/site';

const totalFilms = categories.reduce((n, c) => n + filmCount(c), 0);

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Portfolio — Michael FPV',
    hasPart: categories.map((c) => ({
      '@type': 'CreativeWork',
      name: c.title,
      url: new URL(`/portfolio/${c.slug}/`, Astro.site).href,
    })),
  },
];
---

<Base
  title="Portfolio — Drone Cinematography Work | Michael FPV"
  description="Real client drone work: wedding aerials, real estate flythroughs, automotive tracking, and commercial production. Shot in Charlotte NC, available nationwide."
  schema={schema}
>
  <div class="page-banner">
    <div class="wrap">
      <div class="eyebrow">Our Work</div>
      <h1>The <em>Portfolio.</em></h1>
      <p>
        Real client work — no stock footage, no composites. Every clip here was flown and cut by
        Michael.
      </p>

      <!-- Index: lets someone jump straight to the category they came for
           instead of scrolling past three they don't need. -->
      <nav class="pf-index" aria-label="Portfolio categories">
        {
          categories.map((cat) => (
            <a href={`#${cat.slug}`} class="pf-index-link">
              <span>{cat.title}</span>
              <span class="pf-index-count">{filmCount(cat)}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="pf-grid">
        {
          categories.map((cat, i) => (
            <article class="pf-row" id={cat.slug} data-index={String(i + 1).padStart(2, '0')}>
              <a
                href={url(`/portfolio/${cat.slug}/`)}
                class="pf-entry"
                aria-label={`View ${cat.title} work`}
              >
                <div class="pf-cat" style={`view-transition-name: tile-${cat.slug}`}>
                  {cat.cover && (
                    <iframe
                      src={streamUrl(cat.cover)}
                      title={`${cat.title} preview`}
                      allow={PLAYER_ALLOW}
                      aria-hidden="true"
                    />
                  )}
                  {!cat.cover && (
                    <div class="pf-empty-tag"><span>Coming soon</span></div>
                  )}
                </div>

                <div class="pf-meta">
                  <div class="pf-meta-head">
                    <span class="pf-num">{String(i + 1).padStart(2, '0')}</span>
                    <h2 class="pf-title">{cat.title}</h2>
                  </div>
                  {cat.blurb && <p class="pf-blurb">{cat.blurb}</p>}
                  <span class="pf-count">
                    {filmCount(cat)} {filmCount(cat) === 1 ? 'film' : 'films'}
                    <span class="pf-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="pf-close rv">
        <div>
          <div class="eyebrow">Get In Touch</div>
          <h2 class="h-lg">Like what you <em>see?</em></h2>
          <p class="body-txt" style="margin-top:1.2rem">
            {totalFilms} films and counting. Send your project details and we'll come back with a
            price.
          </p>
        </div>
        <a class="btn btn-solid" href={url('/book/')}>Book a Shoot</a>
      </div>
    </div>
  </section>
</Base>
