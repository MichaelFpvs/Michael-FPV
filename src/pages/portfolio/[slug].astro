---
import Base from '../../layouts/Base.astro';
import { categories, streamUrl, type Category, url, portraitCovers, PLAYER_ALLOW } from '../../data/site';

// One real, indexable page per category — this is the big SEO win over the
// old single-URL build.
export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

interface Props { cat: Category }
const { cat } = Astro.props;

// Flatten tabs or plain video list into a consistent shape
const tabs = cat.tabs ?? [{ key: 'main', label: cat.title, videos: cat.videos ?? [] }];
const hasTabs = Boolean(cat.tabs && cat.tabs.length > 1);

const schema = [
  {
    '@type': 'Service',
    name: `${cat.title} Drone Videography`,
    description: cat.metaDescription,
    provider: { '@id': `${Astro.site?.href}#business` },
    areaServed: { '@type': 'City', name: 'Charlotte' },
  }
];
---

<Base
  title={`${cat.shortTitle ?? cat.title} Drone Videography | Michael FPV`}
  description={cat.metaDescription}
  schema={schema}
>
  <div class="page-banner">
    <div class="wrap">
      <a
        href={url('/portfolio/')}
        style="display:inline-flex;align-items:center;gap:0.5rem;color:var(--muted);font-family:var(--M);font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:1.4rem;text-decoration:none;min-height:44px"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M19 12H5M11 18l-6-6 6-6"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Back to Portfolio
      </a>
      <div class="eyebrow">Portfolio</div>
      <h1>{cat.title} <em>Reel.</em></h1>

      {
        hasTabs && (
          <div id="cat-tabs" style="display:flex;gap:0.6rem;margin-top:1.6rem;flex-wrap:wrap">
            {tabs.map((t, i) => (
              <button
                class:list={['cat-tab', { on: i === 0 }]}
                data-tab={t.key}
                type="button"
              >
                {t.label}
              </button>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      {
        tabs.map((t, i) => (
          <div
            class="cat-panel grid-2 rv-stagger"
            data-panel={t.key}
            style={`gap:1.2rem;${i === 0 ? '' : 'display:none'}`}
          >
            {t.videos.length === 0 ? (
              <p
                style="grid-column:1/-1;text-align:center;padding:4rem 1rem;font-family:var(--M);font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted)"
              >
                Videos for this category are coming soon.
              </p>
            ) : (
              t.videos.map((v, vi) => (
                <div
                  class={`cat-vid${portraitCovers.includes(v.stream) ? ' is-portrait' : ''}`}
                  style={i === 0 && vi === 0 ? `view-transition-name: tile-${cat.slug}` : undefined}
                  data-stream={v.stream}
                  data-silent={v.silent ? 'true' : undefined}
                  role="button"
                  tabindex="0"
                  aria-label={`Play ${v.label}`}
                >
                  <span class="play-mark" aria-hidden="true" />
                  <iframe
                    src={streamUrl(v.stream)}
                    title={v.label}
                    allow={PLAYER_ALLOW}
                    aria-hidden="true"
                  />
                </div>
              ))
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div
        class="rv"
        style="background:var(--paper-2);border:1px solid var(--rule);border-radius:20px;padding:4rem 3rem;text-align:center"
      >
        <h2 class="h-lg" style="margin-bottom:1rem">Like what you <em>see?</em></h2>
        <p class="body-txt" style="max-width:480px;margin:0 auto 2rem">
          Let's get your shoot on the calendar.
        </p>
        <a class="btn btn-gold" href={url('/book/')}>Book a Shoot</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cat-tab {
    font-family: var(--M);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-2);
    border: 1px solid var(--rule-2);
    padding: 0 1.2rem;
    min-height: 44px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cat-tab:hover { color: var(--ink); border-color: var(--muted); }
  .cat-tab.on { background: var(--accent); color: #160f08; border-color: var(--accent); }

</style>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
    tabs.forEach((btn) => {
      if ((btn as any)._bound) return;
      (btn as any)._bound = true;
      btn.addEventListener('click', () => {
        tabs.forEach((b) => b.classList.remove('on'));
        btn.classList.add('on');
        document.querySelectorAll<HTMLElement>('.cat-panel').forEach((p) => {
          p.style.display = p.dataset.panel === btn.dataset.tab ? '' : 'none';
        });
      });
    });
  }
  initTabs();
  document.addEventListener('astro:page-load', initTabs);
</script>
