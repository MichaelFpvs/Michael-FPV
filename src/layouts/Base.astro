---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import { ClientRouter } from 'astro:transitions';
import { site, faqs, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes to merge into the @graph for this page */
  schema?: unknown[];
  /** Include the FAQ schema (home page only, to avoid duplicates) */
  includeFaq?: boolean;
}

const { title, description, schema = [], includeFaq = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = Astro.site?.href ?? '/';
const ogImage = new URL('og-image.jpg', Astro.site).href;

const business = {
  '@type': 'ProfessionalService',
  '@id': `${origin}#business`,
  name: site.name,
  // Every spelling someone might type or that another site might use.
  // Helps Google connect these variants to one business.
  alternateName: [
    'MichaelFPV',
    'Michael FPV Drone Cinematography',
    'Michael FPV Charlotte',
    'Michael FPV Drone',
  ],
  slogan: 'Capture Your Journey',
  knowsAbout: [
    'FPV drone cinematography',
    'Real estate videography',
    'Wedding videography',
    'Aerial photography',
    'Drone flythroughs',
  ],
  description: site.description,
  url: origin,
  telephone: '+1-980-397-9127',
  email: site.email,
  founder: { '@type': 'Person', name: site.owner },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 35.2271, longitude: -80.8431 },
  areaServed: [
    { '@type': 'City', name: site.city, containedInPlace: { '@type': 'State', name: site.regionFull } },
    { '@type': 'Country', name: 'United States' },
  ],
  serviceType: [
    'FPV Drone Cinematography',
    'Real Estate Videography',
    'Wedding Videography',
    'Aerial Photography',
    'Commercial Video Production',
  ],
  priceRange: '$$',
  sameAs: [site.instagram],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'FAA Part 107 Remote Pilot Certificate',
  },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${origin}#website` },
  about: { '@id': `${origin}#business` },
};

const person = {
  '@type': 'Person',
  '@id': `${origin}#owner`,
  name: site.owner,
  jobTitle: 'FPV Drone Pilot and Cinematographer',
  worksFor: { '@id': `${origin}#business` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'US',
  },
  sameAs: [site.instagram],
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  url: origin,
  name: site.name,
  alternateName: 'MichaelFPV',
  publisher: { '@id': `${origin}#business` },
  inLanguage: 'en-US',
};

const faqNode = includeFaq
  ? [
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      },
    ]
  : [];

// Breadcrumbs let Google show "michaelfpv.com › Portfolio › Weddings"
// in results rather than a raw URL.
const segments = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '/')
  .split('/')
  .filter(Boolean);

const crumbs =
  segments.length === 0
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
            ...segments.map((seg, i) => ({
              '@type': 'ListItem',
              position: i + 2,
              name: seg
                .split('-')
                .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
                .join(' '),
              item: new URL(
                segments.slice(0, i + 1).join('/') + '/',
                Astro.site
              ).href,
            })),
          ],
        },
      ];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [business, person, website, webpage, ...crumbs, ...faqNode, ...schema],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={site.owner} />
    <meta name="theme-color" content="#141110" />
    <meta name="geo.region" content="US-NC" />
    <meta name="geo.placename" content={site.city} />

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/favicon.svg')} />

    <!-- Safari and iOS. Without these the site looks generic when saved
         to a home screen, and Safari invents a name from the URL. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Michael FPV" />
    <link rel="mask-icon" href={url('/favicon.svg')} color="#d1543a" />
    <!-- Stops iOS turning stray numbers into phone links inside body copy. -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content="Michael FPV" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Michael FPV drone cinematography" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://iframe.videodelivery.net" crossorigin />
    <link rel="preconnect" href="https://videodelivery.net" crossorigin />
    <link rel="preconnect" href="https://cloudflarestream.com" crossorigin />
    <link rel="dns-prefetch" href="https://iframe.videodelivery.net" />
    <link rel="dns-prefetch" href="https://videodelivery.net" />
    <link rel="dns-prefetch" href="https://cloudflarestream.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Inter:opsz,wght@14..32,400;14..32,500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Smooth cross-page transitions instead of a white flash on every click -->
    <ClientRouter />
  </head>

  <body class={Astro.url.pathname === (import.meta.env.BASE_URL || "/") ? "" : "no-hero"}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <VideoModal />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ── Runs once for the lifetime of the tab ──────────────────────
      // Document-level listeners must NOT be re-registered on each page
      // transition or they stack up and fire multiple times.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const vm = document.getElementById('vmodal');
          if (vm && vm.style.display === 'flex') {
            (window as any).vmodalClose?.();
            return;
          }
        }
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const el = document.activeElement as HTMLElement | null;
        if (el?.getAttribute('role') === 'button') {
          e.preventDefault();
          el.click();
        }
      });

      let navEl: HTMLElement | null = null;
      const onScroll = () => navEl?.classList.toggle('bg', window.scrollY > 60);
      window.addEventListener('scroll', onScroll, { passive: true });

      // ── Re-runs after every view transition ───────────────────────
      // The body is swapped on navigation, so element references and
      // IntersectionObservers have to be rebound to the new nodes.
      // ── SAFARI AUTOPLAY FALLBACK ─────────────────────────────
      // Safari gates autoplay harder than Chrome. Low Power Mode, or a
      // per-site "Never Auto-Play" setting, will leave a video sitting
      // paused even when muted+playsinline are set correctly.
      //
      // Cloudflare's player is cross-origin so we cannot call play() on
      // it. What we can do is reload the frame once, on the first real
      // interaction — a load started by a user gesture is allowed to
      // autoplay. Runs once per page, WebKit only, so no one else sees
      // a reload.
      (function safariAutoplayRescue() {
        const ua = navigator.userAgent;
        const isWebKit = /^((?!chrome|android|crios|fxios|edg).)*safari/i.test(ua);
        if (!isWebKit) return;

        let rescued = false;
        function rescue() {
          if (rescued) return;
          rescued = true;
          document
            .querySelectorAll<HTMLIFrameElement>('iframe[src*="videodelivery"]')
            .forEach((frame) => {
              // Skip the fullscreen player - it is already gesture-driven.
              if (frame.closest('#vmodal')) return;
              const src = frame.src;
              if (!src) return;
              frame.src = src;
            });
          ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach((ev) =>
            window.removeEventListener(ev, rescue)
          );
        }

        // Give normal autoplay a brief moment first, then arm the fallback so
        // a blocked video recovers on the very first touch rather than later.
        setTimeout(() => {
          if (rescued) return;
          ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach((ev) =>
            window.addEventListener(ev, rescue, { once: true, passive: true })
          );
        }, 400);
      })();

      // ── MAGNETIC BUTTONS ──────────────────────────────────────
      // Buttons lean very slightly toward the cursor. Subtle enough
      // that it reads as responsiveness rather than a gimmick, and
      // skipped entirely on touch, where there is no cursor to follow.
      const FINE_POINTER = window.matchMedia('(pointer: fine)').matches;
      const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function bindMagnetic() {
        if (!FINE_POINTER || REDUCED) return;
        document.querySelectorAll<HTMLElement>('.btn, .nav-cta').forEach((el) => {
          if ((el as any)._mag) return;
          (el as any)._mag = true;
          el.style.willChange = 'transform';
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) / r.width;
            const y = (e.clientY - r.top - r.height / 2) / r.height;
            el.style.transform = `translate(${x * 6}px, ${y * 4}px)`;
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      }

      // ── TILE PARALLAX ─────────────────────────────────────────
      // Video inside each tile drifts a little slower than the page.
      // Uses one shared observer and a single rAF loop rather than a
      // scroll handler per tile.
      let parallaxTiles: HTMLElement[] = [];
      let ticking = false;
      function runParallax() {
        const vh = window.innerHeight;
        parallaxTiles.forEach((tile) => {
          const r = tile.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) return;
          const progress = (r.top + r.height / 2 - vh / 2) / vh;
          const frame = tile.querySelector<HTMLElement>('iframe');
          if (frame) frame.style.setProperty('--drift', `${(-progress * 14).toFixed(2)}px`);
        });
        ticking = false;
      }
      function onScrollParallax() {
        if (ticking || REDUCED) return;
        ticking = true;
        requestAnimationFrame(runParallax);
      }
      window.addEventListener('scroll', onScrollParallax, { passive: true });

      function bindParallax() {
        if (REDUCED) return;
        parallaxTiles = Array.from(document.querySelectorAll<HTMLElement>('.pf-cat, .cat-vid'));
        runParallax();
      }

      // ── HERO HANDOFF ──────────────────────────────────────────
      // As the content rises over the hero, the hero sinks slightly and
      // dims. One rAF-throttled handler, and it detaches on pages that
      // have no hero so nothing runs needlessly.
      let heroEl: HTMLElement | null = null;
      let heroTick = false;
      function runHero() {
        if (!heroEl) { heroTick = false; return; }
        const vh = window.innerHeight;
        const p = Math.min(Math.max(window.scrollY / vh, 0), 1);
        const eased = p * p;
        // The hero doesn't just fade — it recedes, blurs, and lets go.
        // Each part moves at its own rate so it comes apart rather than
        // dimming as one flat sheet.
        heroEl.style.setProperty('--hero-scale', String(1 - eased * 0.12));
        heroEl.style.setProperty('--hero-lift', `${-eased * 70}px`);
        heroEl.style.setProperty('--hero-fade', String(1 - eased * 0.95));
        heroEl.style.setProperty('--hero-blur', `${eased * 7}px`);

        // Text leaves first and travels further, so the words clear the
        // frame before the footage behind them is gone.
        const content = heroEl.querySelector('.hero-content') as HTMLElement | null;
        if (content) {
          const t = Math.min(p / 0.62, 1);
          const te = t * t;
          content.style.setProperty('--hc-fade', String(1 - te));
          content.style.setProperty('--hc-lift', `${-te * 120}px`);
          content.style.setProperty('--hc-blur', `${te * 5}px`);
        }
        heroTick = false;
      }
      function onHeroScroll() {
        if (heroTick || !heroEl || REDUCED) return;
        heroTick = true;
        requestAnimationFrame(runHero);
      }
      window.addEventListener('scroll', onHeroScroll, { passive: true });

      function bindHero() {
        heroEl = document.getElementById('hero');
        if (heroEl && !REDUCED) runHero();
      }

      function initPage() {
        navEl = document.getElementById('nav');
        onScroll();
        bindMagnetic();
        bindParallax();
        bindHero();

        document.querySelectorAll('.rv,.rv-l,.rv-r,.rv-stagger').forEach((el) => {
          if ((el as any)._seen) return;
          (el as any)._seen = true;
          new IntersectionObserver(
            (entries, io) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          ).observe(el);
        });
      }

      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
