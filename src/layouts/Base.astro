---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import { ClientRouter } from 'astro:transitions';
import { site, faqs, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes to merge into the @graph for this page */
  schema?: unknown[];
  /** Include the FAQ schema (home page only, to avoid duplicates) */
  includeFaq?: boolean;
}

const { title, description, schema = [], includeFaq = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = Astro.site?.href ?? '/';
const ogImage = new URL('og-image.jpg', Astro.site).href;

const business = {
  '@type': 'ProfessionalService',
  '@id': `${origin}#business`,
  name: site.name,
  // Every spelling someone might type or that another site might use.
  // Helps Google connect these variants to one business.
  alternateName: [
    'MichaelFPV',
    'Michael FPV Drone Cinematography',
    'Michael FPV Charlotte',
    'Michael FPV Drone',
  ],
  slogan: 'Capture Your Journey',
  knowsAbout: [
    'FPV drone cinematography',
    'Real estate videography',
    'Wedding videography',
    'Aerial photography',
    'Drone flythroughs',
  ],
  description: site.description,
  url: origin,
  telephone: '+1-980-397-9127',
  email: site.email,
  founder: { '@type': 'Person', name: site.owner },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 35.2271, longitude: -80.8431 },
  areaServed: [
    { '@type': 'City', name: site.city, containedInPlace: { '@type': 'State', name: site.regionFull } },
    { '@type': 'Country', name: 'United States' },
  ],
  serviceType: [
    'FPV Drone Cinematography',
    'Real Estate Videography',
    'Wedding Videography',
    'Aerial Photography',
    'Commercial Video Production',
  ],
  priceRange: '$$',
  sameAs: [site.instagram],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: 'FAA Part 107 Remote Pilot Certificate',
  },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${origin}#website` },
  about: { '@id': `${origin}#business` },
};

const person = {
  '@type': 'Person',
  '@id': `${origin}#owner`,
  name: site.owner,
  jobTitle: 'FPV Drone Pilot and Cinematographer',
  worksFor: { '@id': `${origin}#business` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'US',
  },
  sameAs: [site.instagram],
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  url: origin,
  name: site.name,
  alternateName: 'MichaelFPV',
  publisher: { '@id': `${origin}#business` },
  inLanguage: 'en-US',
};

const faqNode = includeFaq
  ? [
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [business, person, website, webpage, ...faqNode, ...schema],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={site.owner} />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="geo.region" content="US-NC" />
    <meta name="geo.placename" content={site.city} />

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Michael FPV drone cinematography" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://iframe.videodelivery.net" crossorigin />
    <link rel="preconnect" href="https://videodelivery.net" crossorigin />
    <link rel="preconnect" href="https://cloudflarestream.com" crossorigin />
    <link rel="dns-prefetch" href="https://iframe.videodelivery.net" />
    <link rel="dns-prefetch" href="https://videodelivery.net" />
    <link rel="dns-prefetch" href="https://cloudflarestream.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700&family=JetBrains+Mono:wght@400;500;600&family=Inter:opsz,wght@14..32,300;14..32,500;14..32,600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Smooth cross-page transitions instead of a white flash on every click -->
    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <VideoModal />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ── Runs once for the lifetime of the tab ──────────────────────
      // Document-level listeners must NOT be re-registered on each page
      // transition or they stack up and fire multiple times.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const vm = document.getElementById('vmodal');
          if (vm && vm.style.display === 'flex') {
            (window as any).vmodalClose?.();
            return;
          }
        }
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const el = document.activeElement as HTMLElement | null;
        if (el?.getAttribute('role') === 'button') {
          e.preventDefault();
          el.click();
        }
      });

      let navEl: HTMLElement | null = null;
      const onScroll = () => navEl?.classList.toggle('bg', window.scrollY > 60);
      window.addEventListener('scroll', onScroll, { passive: true });

      // ── Re-runs after every view transition ───────────────────────
      // The body is swapped on navigation, so element references and
      // IntersectionObservers have to be rebound to the new nodes.
      // ── SAFARI AUTOPLAY FALLBACK ─────────────────────────────
      // Safari gates autoplay harder than Chrome. Low Power Mode, or a
      // per-site "Never Auto-Play" setting, will leave a video sitting
      // paused even when muted+playsinline are set correctly.
      //
      // Cloudflare's player is cross-origin so we cannot call play() on
      // it. What we can do is reload the frame once, on the first real
      // interaction — a load started by a user gesture is allowed to
      // autoplay. Runs once per page, WebKit only, so no one else sees
      // a reload.
      (function safariAutoplayRescue() {
        const ua = navigator.userAgent;
        const isWebKit = /^((?!chrome|android|crios|fxios|edg).)*safari/i.test(ua);
        if (!isWebKit) return;

        let rescued = false;
        function rescue() {
          if (rescued) return;
          rescued = true;
          document
            .querySelectorAll<HTMLIFrameElement>('iframe[src*="videodelivery"]')
            .forEach((frame) => {
              // Skip the fullscreen player - it is already gesture-driven.
              if (frame.closest('#vmodal')) return;
              const src = frame.src;
              if (!src) return;
              frame.src = src;
            });
          ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach((ev) =>
            window.removeEventListener(ev, rescue)
          );
        }

        // Give normal autoplay a brief moment first, then arm the fallback so
        // a blocked video recovers on the very first touch rather than later.
        setTimeout(() => {
          if (rescued) return;
          ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach((ev) =>
            window.addEventListener(ev, rescue, { once: true, passive: true })
          );
        }, 400);
      })();

      function initPage() {
        navEl = document.getElementById('nav');
        onScroll();

        document.querySelectorAll('.rv,.rv-l,.rv-r,.rv-stagger').forEach((el) => {
          if ((el as any)._seen) return;
          (el as any)._seen = true;
          new IntersectionObserver(
            (entries, io) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          ).observe(el);
        });
      }

      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
